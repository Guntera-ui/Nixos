{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/logo.ansi",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 4
    }
  },

  "display": {
    "separator": "  "
  },

  "modules": [

    // ─────────────────────────────────────────────
    // HEADER
    // ─────────────────────────────────────────────

    {
      "type": "custom",
      "format": "   \u001b[38;5;213m╭─  Gunter@\u001b[38;5;111mGunterNix\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;147m│\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;147m│\u001b[0m      \u001b[1;38;5;81m\u001b[0m   \u001b[1;38;5;213mN I X O S\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;147m│\u001b[0m          \u001b[38;5;111m╰──\u001b[38;5;147m◇\u001b[38;5;183m──╼\u001b[0m  \u001b[1;38;5;81mH Y P R L A N D\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;147m│\u001b[0m"
    },


    // ─────────────────────────────────────────────
    // SYSTEM
    // ─────────────────────────────────────────────

    {
      "type": "custom",
      "format": "\u001b[38;5;213m├─ \u001b[1;38;5;218mSYSTEM\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[38;5;213m│  ❉  OS\u001b[0m"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;5;183m│    Kernel\u001b[0m"
    },
    {
      "type": "uptime",
      "key": "\u001b[38;5;147m│  󰔛  Uptime\u001b[0m"
    },
    {
      "type": "packages",
      "key": "\u001b[38;5;111m│  󰏖  Packages\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;111m│\u001b[0m"
    },


    // ─────────────────────────────────────────────
    // DESKTOP
    // ─────────────────────────────────────────────

    {
      "type": "custom",
      "format": "\u001b[38;5;147m├─ \u001b[1;38;5;147mDESKTOP\u001b[0m"
    },
    {
      "type": "wm",
      "key": "\u001b[38;5;147m│    WM\u001b[0m"
    },
    {
      "type": "display",
      "key": "\u001b[38;5;111m│  󰍹  Display\u001b[0m",
      "compactType": "original"
    },
    {
      "type": "terminal",
      "key": "\u001b[38;5;81m│    Terminal\u001b[0m"
    },
    {
      "type": "shell",
      "key": "\u001b[38;5;80m│    Shell\u001b[0m"
    },
    {
      "type": "terminalfont",
      "key": "\u001b[38;5;217m│  󰛖  Font\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;111m│\u001b[0m"
    },


    // ─────────────────────────────────────────────
    // HARDWARE
    // ─────────────────────────────────────────────

    {
      "type": "custom",
      "format": "\u001b[38;5;80m├─ \u001b[1;38;5;80mHARDWARE\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "\u001b[38;5;80m│    CPU\u001b[0m"
    },
    {
      "type": "gpu",
      "key": "\u001b[38;5;81m│  󰢮  GPU\u001b[0m"
    },
    {
      "type": "memory",
      "key": "\u001b[38;5;111m│    Memory\u001b[0m"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "\u001b[38;5;147m│  󰋊  Disk\u001b[0m"
    },
    {
      "type": "battery",
      "key": "\u001b[38;5;217m│  󰁹  Battery\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;217m│\u001b[0m"
    },


    // ─────────────────────────────────────────────
    // A LONG TIME AGO...
    // ─────────────────────────────────────────────

    {
      "type": "custom",
      "format": "\u001b[38;5;217m├─ \u001b[1;38;5;217mA LONG TIME AGO...\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;217m│\u001b[0m"
    },

    // top streak
    {
      "type": "custom",
      "format": "          \u001b[38;5;81m·✦\u001b[38;5;111m━━━━\u001b[38;5;147m━━━━\u001b[38;5;183m━\u001b[38;5;213m✦·\u001b[0m"
    },

    // center streak
    {
      "type": "custom",
      "format": "      \u001b[38;5;81m╺━━━━\u001b[38;5;111m━━━━\u001b[38;5;147m━━◇━━\u001b[38;5;183m━━━━\u001b[38;5;213m━━━━╸\u001b[0m"
    },

    // bottom streak
    {
      "type": "custom",
      "format": "          \u001b[38;5;80m·✦\u001b[38;5;111m━━━━\u001b[38;5;147m━━━━\u001b[38;5;183m━\u001b[38;5;217m✦·\u001b[0m"
    },

    // bottom border
    {
      "type": "custom",
      "format": "\u001b[38;5;111m╰──────────────────────────────────────────────────────\u001b[0m"
    }
  ]
}
